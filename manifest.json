{
  "manifest_version": 3,
  "name": "UTM Builder & Checker for GA4 – The Growth Folks®",
  "short_name": "UTM Builder",
  "version": "0.3.0",
  "homepage_url": "https://thegrowthfolks.com/tools/utm-builder/",
  "description": "Build and check UTM links for GA4. See the channel before you share. Page and email checker, WhatsApp links, bulk and QR.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "UTM Builder & Checker",
    "default_popup": "src/panel/panel.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "sidePanel",
    "clipboardWrite",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://api-ssl.bitly.com/*",
    "https://api.dub.co/*",
    "https://api.rebrandly.com/*",
    "https://mail.google.com/*",
    "https://outlook.office.com/*",
    "https://outlook.office365.com/*",
    "https://outlook.live.com/*",
    "https://app.hubspot.com/*",
    "https://app-eu1.hubspot.com/*",
    "https://*.mailchimp.com/*",
    "https://www.klaviyo.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+U"
      },
      "description": "Open UTM Builder & Checker"
    }
  },
  "optional_permissions": [
    "tabs"
  ]
}
